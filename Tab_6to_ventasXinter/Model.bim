            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              " SWITCH(TRUE(), DimCustomer[Gender] = \"M\", \"Masculino\", ",
              "    DimCustomer[Gender] = \"F\", \"Femenino\", ",
              "    DimCustomer[Gender] = \"Casado\", \"Soltero\", ",
              "    \"Soltero\")"
            ]
