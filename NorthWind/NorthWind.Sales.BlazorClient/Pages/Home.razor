@page "/"

<PageTitle>Punto de Venta NorthWind</PageTitle>

<div class="py-5 text-center">
    <h1 class="display-5 fw-bold">¡Bienvenidos al Punto de Venta NorthWind!</h1>
    <p class="lead text-muted mt-3 mb-4">
        Registre ventas, controle el inventario y consulte sus facturas
        de forma rápida y segura.
    </p>

    <AuthorizeView>
        <Authorized>
            <div class="d-flex flex-wrap justify-content-center gap-3">
                <a class="btn btn-primary btn-lg" href="createorder">Nueva venta</a>
                <a class="btn btn-outline-secondary btn-lg" href="invoices">Consultar facturas</a>
            </div>
        </Authorized>
    </AuthorizeView>
</div>
