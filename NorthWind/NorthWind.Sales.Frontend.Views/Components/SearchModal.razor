@typeparam TItem
@implements IDisposable
@using NorthWind.Sales.Entities.Dtos.Search

<div class="modal fade show d-block" tabindex="-1" role="dialog"
     style="background-color: rgba(0,0,0,.5);">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Title</h5>
                <button type="button" class="btn-close" aria-label="@PosMessages.CloseButton"
                        @onclick="OnClose"></button>
            </div>

            <div class="modal-body">
                <div class="row g-2 mb-3">
                    <div class="col-12 col-md-8">
                        <input type="text" class="form-control"
                               placeholder="@PosMessages.SearchPlaceholder"
                               value="@SearchText"
                               @oninput="OnSearchInput" />
                    </div>
                    <div class="col-12 col-md-4">
                        <select class="form-select"
                                aria-label="@SearchFilterMessages.FilterLabel"
                                title="@SearchFilterMessages.FilterLabel"
                                @bind="SelectedField"
                                @bind:after="OnFilterChanged">
                            @foreach (var Option in Filters)
                            {
                                <option value="@Option.Key">@Option.Label</option>
                            }
                        </select>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Error))
                {
                    <div class="alert alert-danger">@Error</div>
                }

                @if (Result == null && IsLoading)
                {
                    <p class="text-muted">@PosMessages.Loading</p>
                }
                else if (Result == null || Result.Items.Count == 0)
                {
                    <p class="text-muted">@PosMessages.NoResults</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-sm align-middle">
                            <thead>
                                <tr>
                                    @HeaderTemplate
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var Item in Result.Items)
                                {
                                    <tr>
                                        @RowTemplate(Item)
                                        <td class="text-end">
                                            <button type="button"
                                                    class="btn btn-sm btn-success"
                                                    @onclick="() => OnSelected.InvokeAsync(Item)">
                                                @PosMessages.SelectButton
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="modal-footer justify-content-between">
                <div>
                    @if (Result != null && Result.TotalPages > 0)
                    {
                        <small class="text-muted">
                            Página @Result.Page de @Result.TotalPages
                            (@Result.TotalCount registros)
                        </small>
                    }
                </div>
                <div>
                    <button type="button" class="btn btn-outline-secondary"
                            disabled="@(!CanGoPrevious)" @onclick="PreviousPage">
                        @PosMessages.PreviousButton
                    </button>
                    <button type="button" class="btn btn-outline-secondary"
                            disabled="@(!CanGoNext)" @onclick="NextPage">
                        @PosMessages.NextButton
                    </button>
                    <button type="button" class="btn btn-secondary"
                            @onclick="OnClose">
                        @PosMessages.CloseButton
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    const int PageSize = 8;
    const int DebounceMilliseconds = 300;

    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter, EditorRequired]
    public Func<string, string, int, int, Task<PagedResultDto<TItem>>> Search { get; set; } = default!;

    // Opciones del filtro "Buscar en". Por defecto solo "Todos los campos".
    [Parameter]
    public List<SearchFilterOption> Filters { get; set; } = [SearchFilterOption.All];

    [Parameter, EditorRequired]
    public RenderFragment HeaderTemplate { get; set; } = default!;

    [Parameter, EditorRequired]
    public RenderFragment<TItem> RowTemplate { get; set; } = default!;

    [Parameter]
    public EventCallback<TItem> OnSelected { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    string SearchText = "";
    string SelectedField = SearchFilterOption.All.Key;
    string? Error;
    bool IsLoading;
    int CurrentPage = 1;
    int RequestId;
    CancellationTokenSource? DebounceCts;
    PagedResultDto<TItem>? Result;

    bool CanGoPrevious => !IsLoading && Result != null && CurrentPage > 1;
    bool CanGoNext => !IsLoading && Result != null && CurrentPage < Result.TotalPages;

    protected override async Task OnInitializedAsync() =>
        await LoadPage(1);

    async Task PreviousPage() => await LoadPage(CurrentPage - 1);
    async Task NextPage() => await LoadPage(CurrentPage + 1);

    // Búsqueda automática: espera una pausa al escribir y consulta sin botón.
    async Task OnSearchInput(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString() ?? "";

        DebounceCts?.Cancel();
        DebounceCts?.Dispose();
        var Cts = DebounceCts = new CancellationTokenSource();

        try
        {
            await Task.Delay(DebounceMilliseconds, Cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await LoadPage(1);
    }

    // Al cambiar el filtro se consulta de inmediato, sin esperar el temporizador.
    async Task OnFilterChanged()
    {
        DebounceCts?.Cancel();
        await LoadPage(1);
    }

    async Task LoadPage(int page)
    {
        int ThisRequest = ++RequestId;
        IsLoading = true;
        Error = null;
        try
        {
            var NewResult = await Search(SearchText?.Trim() ?? "", SelectedField, page, PageSize);

            // Si llegó una búsqueda más nueva, se descarta esta respuesta.
            if (ThisRequest != RequestId)
            {
                return;
            }

            Result = NewResult;
            CurrentPage = page;
        }
        catch (Exception)
        {
            if (ThisRequest == RequestId)
            {
                Error = PosMessages.SearchFailed;
            }
        }
        finally
        {
            if (ThisRequest == RequestId)
            {
                IsLoading = false;
            }
        }
    }

    public void Dispose()
    {
        DebounceCts?.Cancel();
        DebounceCts?.Dispose();
    }
}
