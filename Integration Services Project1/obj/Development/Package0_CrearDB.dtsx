    <DTS:Executable
      DTS:refId="Package\Execute SQL Task 1"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{e694406d-1f4b-4da5-94c6-4c5151fa6b56}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Execute SQL Task 1"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{81E99ECF-46CA-492B-8503-318E5386029F}"
          SQLTask:SqlStatementSource="-----------------------------------------------------------&#xA;-- ELIMINAR TABLAS SI YA EXISTEN (EN ORDEN DE DEPENDENCIAS)&#xA;-----------------------------------------------------------&#xA;DROP TABLE IF EXISTS dbo.factVentas;&#xA;DROP TABLE IF EXISTS dbo.dimProductos;&#xA;DROP TABLE IF EXISTS dbo.dimSubCategorias;&#xA;DROP TABLE IF EXISTS dbo.dimCategorias;&#xA;DROP TABLE IF EXISTS dbo.dimModelos;&#xA;DROP TABLE IF EXISTS dbo.dimClientes;&#xA;DROP TABLE IF EXISTS dbo.dimFechas;&#xA;&#xA;&#xA;-----------------------------------------------------------&#xA;-- DIMENSIONES&#xA;-----------------------------------------------------------&#xA;CREATE TABLE dbo.dimCategorias(&#xA;    CategoriaID INT NOT NULL,&#xA;    Categoria VARCHAR(50) NULL,&#xA;    CONSTRAINT PK_dimCategorias PRIMARY KEY CLUSTERED (CategoriaID ASC)&#xA;);&#xA;&#xA;CREATE TABLE dbo.dimSubCategorias(&#xA;    SubCategoriaID INT NOT NULL,&#xA;    SubCategoria VARCHAR(50) NULL,&#xA;    categoriaId INT NULL,&#xA;    CONSTRAINT PK_dimSubCategorias PRIMARY KEY CLUSTERED (SubCategoriaID ASC),&#xA;    CONSTRAINT FK_dimSubCategorias_dimCategorias &#xA;        FOREIGN KEY (categoriaId) REFERENCES dbo.dimCategorias (CategoriaID)&#xA;);&#xA;&#xA;CREATE TABLE dbo.dimModelos(&#xA;    ModeloID INT NOT NULL,&#xA;    Modelo VARCHAR(50) NULL,&#xA;    CONSTRAINT PK_dimModelos PRIMARY KEY CLUSTERED (ModeloID ASC)&#xA;);&#xA;&#xA;CREATE TABLE dbo.dimProductos(&#xA;    ProductoID INT NOT NULL,&#xA;    SubCategoriaID INT NOT NULL,&#xA;    ModeloID INT NOT NULL,&#xA;    Producto VARCHAR(50) NOT NULL,&#xA;    CONSTRAINT PK_dimProductos PRIMARY KEY CLUSTERED (ProductoID ASC),&#xA;    CONSTRAINT FK_dimProductos_dimSubCategorias &#xA;        FOREIGN KEY (SubCategoriaID) REFERENCES dbo.dimSubCategorias (SubCategoriaID),&#xA;    CONSTRAINT FK_dimProductos_dimModelos &#xA;        FOREIGN KEY (ModeloID) REFERENCES dbo.dimModelos (ModeloID)&#xA;);&#xA;&#xA;CREATE TABLE dbo.dimClientes(&#xA;    ClienteID INT NOT NULL,&#xA;    Cliente VARCHAR(50) NULL,&#xA;    Tipo CHAR(2) NULL,&#xA;    CONSTRAINT PK_dimClientes PRIMARY KEY CLUSTERED (ClienteID ASC)&#xA;);&#xA;&#xA;CREATE TABLE dbo.dimFechas(&#xA;    FechaID INT NOT NULL,&#xA;    Anio SMALLINT NOT NULL,&#xA;    Trimestre VARCHAR(12) NOT NULL,&#xA;    Mes VARCHAR(12) NOT NULL,&#xA;    Fecha DATE NOT NULL,&#xA;    CONSTRAINT PK_dimFechas PRIMARY KEY CLUSTERED (FechaID ASC)&#xA;);&#xA;&#xA;&#xA;-----------------------------------------------------------&#xA;-- TABLA DE HECHOS&#xA;-----------------------------------------------------------&#xA;CREATE TABLE dbo.factVentas(&#xA;    VentaID INT NOT NULL,&#xA;    ClienteID INT NULL,&#xA;    ProductoId INT NULL,&#xA;    FechaID INT NULL,&#xA;    Cantidad SMALLINT NOT NULL,&#xA;    PrecioUnitario MONEY NOT NULL,&#xA;    Descuento MONEY NOT NULL,&#xA;    DescuentoTotal MONEY NOT NULL,&#xA;    CONSTRAINT PK_factVentas PRIMARY KEY CLUSTERED (VentaID ASC),&#xA;    CONSTRAINT FK_factVentas_dimClientes &#xA;        FOREIGN KEY (ClienteID) REFERENCES dbo.dimClientes (ClienteID),&#xA;    CONSTRAINT FK_factVentas_dimProductos &#xA;        FOREIGN KEY (ProductoId) REFERENCES dbo.dimProductos (ProductoID),&#xA;    CONSTRAINT FK_factVentas_dimFechas &#xA;        FOREIGN KEY (FechaID) REFERENCES dbo.dimFechas (FechaID)&#xA;);&#xA;&#xA;&#xA;-----------------------------------------------------------&#xA;-- VERIFICACIÓN DE FKs&#xA;-----------------------------------------------------------&#xA;SELECT &#xA;    fk.name AS NombreRelacion_FK,&#xA;    tp.name AS TablaPadre_Dimension,&#xA;    ref.name AS TablaHijo_Referenciada&#xA;FROM sys.foreign_keys fk&#xA;INNER JOIN sys.tables tp ON fk.referenced_object_id = tp.object_id&#xA;INNER JOIN sys.tables ref ON fk.parent_object_id = ref.object_id;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
