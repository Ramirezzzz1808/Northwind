    <DTS:Executable
      DTS:refId="Package\Poblar Fechas"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{6028E572-6055-44D9-AAE5-84B9DFCBBB64}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Poblar Fechas"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9A767D27-BE66-4B5B-8426-44D4CB30464A}"
          SQLTask:SqlStatementSource="WITH CTE_Fechas AS (&#xA;    SELECT CAST('2022-01-01' AS DATE) AS Fecha&#xA;    UNION ALL&#xA;    SELECT DATEADD(DAY, 1, Fecha)&#xA;    FROM CTE_Fechas&#xA;    WHERE Fecha &lt; '2025-12-31'&#xA;)&#xA;INSERT INTO DescuentosDW6to.dbo.dimFechas (FechaID, Anio, Trimestre, Mes, Fecha)&#xA;SELECT &#xA;    CAST(CONVERT(VARCHAR(8), Fecha, 112) AS INT) AS FechaID,&#xA;    YEAR(Fecha) AS Anio,&#xA;    DATEPART(QUARTER, Fecha) AS Trimestre,&#xA;    MONTH(Fecha) AS Mes,&#xA;    Fecha&#xA;FROM CTE_Fechas&#xA;OPTION (MAXRECURSION 0); " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
