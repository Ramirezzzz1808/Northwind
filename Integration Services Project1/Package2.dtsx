                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    d.SalesOrderDetailID AS VentaID,
    h.CustomerID AS ClienteID,
    d.ProductID AS ProductoID,
    CAST(CONVERT(VARCHAR(8), h.OrderDate, 112) AS INT) AS FechaID,
    d.OrderQty AS Cantidad,
    d.UnitPrice AS PrecioUnitario,
    d.UnitPriceDiscount AS Descuento,
    CAST((d.UnitPrice * d.OrderQty * d.UnitPriceDiscount) AS MONEY) AS DescuentoTotal
FROM AdventureWorks2025.Sales.SalesOrderHeader h
INNER JOIN AdventureWorks2025.Sales.SalesOrderDetail d 
    ON h.SalesOrderID = d.SalesOrderID
INNER JOIN DescuentosDW6to.dbo.dimProductos dp 
    ON d.ProductID = dp.ProductoID
INNER JOIN DescuentosDW6to.dbo.dimClientes dc 
    ON h.CustomerID = dc.ClienteID;</property>
