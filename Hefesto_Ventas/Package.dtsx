                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    SOH.CustomerID AS idCliente,
    SOD.ProductID AS idProducto,
    CAST(CONVERT(VARCHAR(8), SOH.OrderDate, 112) AS INT) AS idFecha,
    SOD.OrderQty AS cantidad,
    SOD.LineTotal AS montoTotal
FROM Sales.SalesOrderHeader AS SOH
INNER JOIN Sales.SalesOrderDetail AS SOD ON SOH.SalesOrderID = SOD.SalesOrderID</property>
