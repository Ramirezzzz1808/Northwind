                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    a.CustomerID, 
    b.PersonType, 
    CONCAT(b.LastName, ' ', b.FirstName) AS name
FROM AdventureWorks2025.Sales.Customer AS a
INNER JOIN AdventureWorks2025.Person.Person AS b 
    ON a.PersonID = b.BusinessEntityID
WHERE a.StoreID IS NOT NULL;</property>
