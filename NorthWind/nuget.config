<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Ignora las fuentes globales de cada máquina (Windows o Linux). -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Paquetes NorthWind.* (Membership, RazorComponents, etc.) incluidos en el repositorio. -->
    <add key="NorthWind Local Packages" value="LocalPackages" />
  </packageSources>
</configuration>
